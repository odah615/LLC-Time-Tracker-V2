{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "llc-time-tracker-sandbox",
  "main": "src/server/apiHandler.js",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "keep_vars": true,
  "vars": {
    "ENVIRONMENT": "sandbox",
    "JWT_SECRET": "sandbox-llc-timetracker-jwt-secret-key-2026"
  }
}
